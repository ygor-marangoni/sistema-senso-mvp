# Use somente o banco independente senso. A API bloqueia qualquer outro banco PostgreSQL.
# Apenas para desenvolvimento local; nunca reutilize estas credenciais em produção.
DATABASE_URL=postgresql+psycopg://senso:senso_dev@localhost:5432/senso
SECRET_KEY=troque-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
COOKIE_NAME=senso_session
APP_ENV=development
DEMO_LOGIN_ENABLED=true
SIMULATION_INTERVAL_SECONDS=2
